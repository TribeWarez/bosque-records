{
  "name": "bosque-records-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --host",
    "build": "vue-tsc --noEmit && vite build",
    "build:check": "vue-tsc && vite build",
    "preview": "vite preview",
    "serve": "vite preview --host",
    "type-check": "vue-tsc --noEmit",
    "type-check:watch": "vue-tsc --noEmit --watch",
    "lint": "eslint . --ext .vue,.js,.jsx,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist node_modules/.vite",
    "deps:update": "npm update",
    "dev:open": "vite --open"
  },
  "dependencies": {
    "@unhead/vue": "^1.11.20",
    "@vueuse/core": "9.13.0",
    "pinia": "2.0.36",
    "three": "0.150.1",
    "vue": "3.2.47",
    "vue-router": "4.1.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/three": "^0.150.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "10.4.14",
    "postcss": "^8.5.6",
    "tailwindcss": "3.2.7",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vue-tsc": "^3.0.4"
  }
}
