{
  "name": "bosque-records-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --host",
    "build": "vue-tsc --noEmit && vite build",
    "build:check": "vue-tsc && vite build",
    "preview": "vite preview",
    "serve": "vite preview --host",
    "type-check": "vue-tsc --noEmit",
    "type-check:watch": "vue-tsc --noEmit --watch",
    "lint": "eslint . --ext .vue,.js,.jsx,.ts,.tsx --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist node_modules/.vite",
    "deps:update": "npm update",
    "dev:open": "vite --open"
  },
  "dependencies": {
    "@unhead/vue": "^2.1.12",
    "@vueuse/core": "14.2.1",
    "pinia": "3.0.4",
    "three": "0.183.2",
    "vue": "3.5.30",
    "vue-router": "5.0.4"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/three": "^0.150.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.0",
    "autoprefixer": "10.4.27",
    "postcss": "^8.5.6",
    "tailwindcss": "4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vue-tsc": "^3.2.6"
  }
}
